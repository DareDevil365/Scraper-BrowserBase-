### Phase 4: Blueprint-Aware Synthesis & Anti-Repetition

#### 1. File to Modify: `engine/extractor.py` (Function: `extract_for_heading`, `synthesize_research_stream`)

##### Design Objective:
Synthesize content section-by-section using the blueprint's dynamic instructions rather than vector divisions. The prompt for each section is populated with the verbatim answers from the user's cross-questioning transcript to ensure compliance. The synthesizer is fed summaries of all previously written sections to prevent content repetition.

##### Python Implementation:

```python
def extract_for_heading(section: dict, heading_content: list[dict], original_query: str) -> dict:
    """
    Concurrently extracts and cleans relevant facts for a single blueprint section
    using accumulated source text.
    """
    if not heading_content:
        return {"success": False, "data": {}, "sources": [], "error": "No content accumulated"}
        
    combined_texts = []
    sources = []
    images = []
    
    for item in heading_content:
        url = item["url"]
        content = item["content"]
        src = item["source"]
        imgs = item.get("images", [])
        
        if content:
            combined_texts.append(f"--- Source: {url} ---\n{content[:5000]}")
            sources.append(src)
            for im in imgs:
                if im not in images:
                    images.append(im)
                    
    source_corpus = "\n\n".join(combined_texts)
    
    prompt = f"""You are a research analyst. Extract information that directly addresses the requirements of this report section.
    
    Report Section: "{section['heading']}"
    Instructions: "{section.get('instructions', '')}"
    Original Query Context: "{original_query}"
    
    Source Material:
    {source_corpus[:25000]}
    
    Extract all facts, comparative details, and data points. Organize them cleanly.
    Return JSON format: {{"data": {{"facts": ["fact A", "fact B"], "tables": [...]}}, "error": null}}
    Return ONLY valid JSON."""

    try:
        response = extractor._call_gemini(
            contents=prompt,
            config=extractor.types.GenerateContentConfig(temperature=0.1),
            tier="strong",
            judgment=True
        )
        parsed = extractor._parse_json_response(response.text)
        return {
            "success": True,
            "data": parsed.get("data") if parsed else {},
            "sources": sources,
            "images": images
        }
    except Exception as e:
        return {"success": False, "error": str(e), "sources": sources, "images": images}


def synthesize_research_stream(
    vectors_data: list,
    original_query: str,
    format_hint: str,
    output_folder: str,
    vectors: list,
    instruction: str = "",
    required_deliverables: list = []
):
    """
    Iterates through blueprint sections, generating markdown content.
    Enforces format rules (Mermaid flowcharts, tables, timelines) based on section types.
    Avoids repetition by providing context from previous sections.
    """
    blueprint_path = os.path.join(output_folder, "blueprint.json")
    if not os.path.exists(blueprint_path):
        return
        
    with open(blueprint_path, "r", encoding="utf-8") as f:
        blueprint = json.load(f)
        
    sections = blueprint.get("sections", [])
    previous_sections_context = []
    
    # Load all heading drafts
    from engine import session_output
    drafts = session_output.load_heading_drafts(output_folder)
    
    # 1. Output Report Title & Meta
    title = blueprint.get("document_title", "Research Report")
    yield f"# {title}\n\n"
    
    # 2. Synthesize Sections Sequently
    for sec in sections:
        sid = sec["id"]
        draft_data = drafts.get(sid, {})
        section_data = draft_data.get("data", {})
        section_images = draft_data.get("images", [])
        
        # Enforce Section Visual Types in prompt instructions
        content_type = sec["content_type"]
        format_instructions = ""
        if content_type == "flowchart":
            format_instructions = "You MUST construct a valid Mermaid.js flowchart (graph TD) illustrating this transaction/process flow."
        elif content_type == "comparison_table":
            format_instructions = "You MUST organize these parameters or competitors into a markdown comparison table with clear headings."
        elif content_type == "timeline":
            format_instructions = "You MUST construct a Mermaid.js timeline or Gantt chart illustrating this chronological roadmap."
        elif content_type == "data_matrix":
            format_instructions = "You MUST construct a structured markdown table matrix mapping parameters to entities."
        
        prompt = f"""You are a master technical writer. Write the content for this section of a research report.
        
        Section Title: "{sec['heading']}"
        Sub-Headings to cover: {json.dumps(sec.get('sub_headings', []))}
        Dynamic Instructions: "{sec.get('instructions', '')}"
        
        Verbatim Requirements (Expanded Prompt):
        {instruction}
        
        Required Deliverables:
        {json.dumps(required_deliverables)}
        
        Formatting Constraint:
        {format_instructions}
        
        Source Facts Extracted:
        {json.dumps(section_data)}
        
        Available Images to Embed (if any):
        {json.dumps(section_images)}
        
        If images are available, embed the most relevant ones using markdown syntax: ![Description](image_url).
        ONLY use the provided image URLs; never fabricate or guess image URLs.
        
        PREVENT REPETITION:
        The following content has already been covered in previous sections. Do NOT duplicate this information:
        {json.dumps(previous_sections_context)}
        
        Output section markdown content (headers, paragraphs, tables, or Mermaid blocks).
        Do NOT wrap the section in code blocks. Write raw markdown."""

        try:
            response = extractor._call_gemini(
                contents=prompt,
                config=extractor.types.GenerateContentConfig(temperature=0.25),
                tier="strong",
                judgment=True
            )
            content = response.text.strip()
            
            # Save section summary to prevent repetition in subsequent sections
            summary_prompt = f"Summarize in 2 sentences what was covered in this text:\n{content[:4000]}"
            sum_resp = extractor._call_gemini(summary_prompt, tier="cheap")
            previous_sections_context.append({
                "heading": sec["heading"],
                "summary": sum_resp.text.strip()
            })
            
            yield f"\n\n## {sec['heading']}\n\n"
            yield content
            
        except Exception as e:
            yield f"\n\n## {sec['heading']}\n\nError generating section: {e}\n"
