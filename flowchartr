### Phase 3: Global Source Pool & Async Fanning Engine

#### 1. File to Modify: `engine/source_pool.py`

##### Design Objective:
Maintain a thread-safe global queue of discovered URLs. Scraping happens once globally. The scraped markdown content, metadata, and extracted images are pushed and mapped (fanned out) to all blueprint headings that require information on that domain or vector topic.

##### Python Implementation:

```python
import heapq
import threading
import json
import os

class SourcePool:
    """
    Thread-safe shared priority queue of URLs to scrape.
    URLs are tagged with ALL relevant blueprint heading IDs.
    Scraped content is accumulated per-heading.
    """
    def __init__(self, blueprint: dict, output_folder: str):
        self.queue = []            # list of (-score, url, entry_dict) for heapq
        self.scraped_cache = {}    # url -> content string
        self.extractions = {}      # url -> extraction dict
        self.heading_data = {}     # heading_id -> list of dicts: {"content": ..., "images": ..., "source": ..., "url": ...}
        self.seen_urls = set()
        self.lock = threading.Lock()
        self.blueprint = blueprint
        self.output_folder = output_folder

        # Initialize heading data structures
        for sec in self.blueprint.get("sections", []):
            sid = sec["id"]
            self.heading_data[sid] = []

    def add_source(self, url: str, title: str, snippet: str, score: float, 
                   source_type: str, relevant_heading_ids: list[str], vector_id: str):
        """Add a URL to the pool, tagged with which headings it serves, if not already seen."""
        with self.lock:
            if url in self.seen_urls:
                # Update headings if this URL serves additional ones
                for item in self.queue:
                    entry = item[2]
                    if entry["url"] == url:
                        for hid in relevant_heading_ids:
                            if hid not in entry["relevant_heading_ids"]:
                                entry["relevant_heading_ids"].append(hid)
                return
            
            self.seen_urls.add(url)
            entry = {
                "url": url,
                "title": title,
                "snippet": snippet,
                "score": score,
                "source_type": source_type,
                "relevant_heading_ids": list(relevant_heading_ids),
                "vector_id": vector_id,
                "scraped": False
            }
            # We push onto a min-heap, so negate the score for a max-priority queue
            heapq.heappush(self.queue, (-score, url, entry))

    def pop_next(self) -> dict or None:
        """Pop the highest-priority unscraped URL entry."""
        with self.lock:
            while self.queue:
                _, _, entry = heapq.heappop(self.queue)
                if not entry["scraped"]:
                    return entry
            return None

    def submit_scraped_content(self, url: str, content: str, images: list, source_entry: dict):
        """
        Called after a scraper finishes. Stores raw content and fans it out
        to all mapped heading accumulators.
        """
        with self.lock:
            self.scraped_cache[url] = content
            source_entry["scraped"] = True

            # Save in queue entries if we still have references to it
            for item in self.queue:
                entry = item[2]
                if entry["url"] == url:
                    entry["scraped"] = True

            for heading_id in source_entry["relevant_heading_ids"]:
                if heading_id not in self.heading_data:
                    self.heading_data[heading_id] = []
                self.heading_data[heading_id].append({
                    "content": content,
                    "images": images,
                    "source": source_entry,
                    "url": url
                })

    def submit_extraction(self, url: str, extraction: dict):
        """Submit structures/parameters extracted from a scraped page."""
        with self.lock:
            self.extractions[url] = extraction

    def get_heading_status(self, heading_id: str) -> str:
        """Check if a heading has enough successful scraped data sources."""
        data = self.heading_data.get(heading_id, [])
        successful = [d for d in data if d.get("content") and len(d["content"]) > 100]
        # Satisfied threshold: 4 successful sources.
        if len(successful) >= 4:
            return "satisfied"
        elif len(successful) >= 1:
            return "partial"
        return "hungry"

    def get_hungry_headings(self) -> list[str]:
        """Return heading IDs that still need more data."""
        hungry = []
        for sec in self.blueprint.get("sections", []):
            sid = sec["id"]
            if self.get_heading_status(sid) in ("hungry", "partial"):
                hungry.append(sid)
        return hungry
```

#### 2. File to Modify: `engine/deep_extractor.py` (Functions: `discover_sources_for_session`, `route_urls_to_headings`, `scrape_and_extract_for_pool`, `adaptive_rediscovery`)

##### Design Objective:
Perform global searches for all vectors in parallel, route discovered URLs to headings using a batch classification prompt, run an async worker pool to pull and scrape, and trigger adaptive re-discovery searches for headings that remain "hungry" (under-sourced).

##### Python Implementation:

```python
import concurrent.futures
from engine import discoverer
from engine import scraper
from engine import extractor
import urllib.parse

def route_urls_to_headings(urls: list[dict], sections: list[dict]) -> dict:
    """
    AI routing mapping urls to sections using a cheap batch Gemini call.
    """
    if not urls or not sections:
        return {}
        
    prompt = f"""Given these scraped URLs and these report headings, classify which headings each URL is relevant to.
    A URL can be relevant to multiple headings.
    
    URLs: {json.dumps([{"url": u["url"], "title": u.get("title", ""), "snippet": u.get("snippet", "")} for u in urls])}
    
    Headings: {json.dumps([{"id": s["id"], "heading": s["heading"], "instructions": s.get("instructions", "")} for s in sections])}
    
    Return JSON format: {{"url_to_headings": {{"url1": ["sec_1", "sec_3"], "url2": ["sec_2"]}}}}
    Return ONLY valid JSON. No markdown code blocks."""

    try:
        response = extractor._call_gemini(
            contents=prompt,
            config=extractor.types.GenerateContentConfig(temperature=0.1),
            tier="cheap",
            judgment=False
        )
        parsed = extractor._parse_json_response(response.text)
        return parsed.get("url_to_headings", {}) if parsed else {}
    except Exception as e:
        print(f"Error routing urls to headings: {e}")
        return {}


def discover_sources_for_session(
    session_id: str,
    vectors: list[dict],
    refined_prompt: str,
    original_query: str,
    depth: str,
    output_folder: str,
    target_authority_domains: list
) -> dict:
    """
    Globally discovers sources for the session, routes them to headings,
    and writes to output_folder/scrape_queue.json to feed the SourcePool.
    """
    # 1. Generate queries for all vectors
    all_queries = []
    for vec in vectors:
        queries = discoverer.generate_search_queries(vec, refined_prompt, depth)
        for q in queries:
            all_queries.append((q, vec["id"]))
            
    # 2. Run searches in parallel
    discovered_urls = {} # url -> dict
    with concurrent.futures.ThreadPoolExecutor(max_workers=5) as executor:
        futures = []
        for q, vec_id in all_queries:
            # call search engine API (e.g. DuckDuckGo or Perplexity)
            from engine.scraper import ddg_search
            futures.append(executor.submit(ddg_search, q, vec_id))
            
        for fut in concurrent.futures.as_completed(futures):
            try:
                results = fut.result()
                for r in results:
                    url = r["url"]
                    if url not in discovered_urls:
                        discovered_urls[url] = r
            except Exception as e:
                print(f"Search future failed: {e}")

    # 3. Route URLs to blueprint headings
    blueprint_path = os.path.join(output_folder, "blueprint.json")
    if os.path.exists(blueprint_path):
        with open(blueprint_path, "r", encoding="utf-8") as f:
            blueprint = json.load(f)
    else:
        # Generate blueprint fallback
        blueprint = discoverer.generate_blueprint(original_query, refined_prompt, vectors, [])
        with open(blueprint_path, "w", encoding="utf-8") as f:
            json.dump(blueprint, f, indent=2)

    url_list = list(discovered_urls.values())
    sections = blueprint.get("sections", [])
    routing_map = route_urls_to_headings(url_list, sections)
    
    # 4. Filter and score URLs using authority boosts
    queue_sources = []
    for url, info in discovered_urls.items():
        rel_headings = routing_map.get(url, [])
        if not rel_headings:
            # Map based on vector matching if AI failed to route
            mapped_vec = info.get("vector_id")
            rel_headings = [s["id"] for s in sections if mapped_vec in s.get("mapped_vector_ids", [])]
            
        score = 50.0
        parsed_domain = urllib.parse.urlparse(url).netloc.lower()
        
        # Boost domains matched in target authority domains
        if any(d.lower() in parsed_domain for d in target_authority_domains):
            score += 30.0
            
        # Boost domains listed in specific section affinities
        for hid in rel_headings:
            sec_obj = next((s for s in sections if s["id"] == hid), None)
            if sec_obj and any(d.lower() in parsed_domain for d in sec_obj.get("source_affinity", [])):
                score += 15.0
                
        info["score"] = score
        info["relevant_heading_ids"] = rel_headings
        queue_sources.append(info)
        
    # Write to queue file
    queue_path = os.path.join(output_folder, "scrape_queue.json")
    with open(queue_path, "w", encoding="utf-8") as f:
        json.dump(queue_sources, f, indent=2)
        
    return {"success": True, "count": len(queue_sources)}


def scrape_and_extract_for_pool(pool: SourcePool, max_workers: int = 3, progress_cb = None, depth: str = "standard"):
    """
    Worker threads pull unscraped URLs from the SourcePool priority queue,
    run async requests, save raw files, and submit scraped text/images.
    """
    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = {}
        
        while True:
            # Get headings that need more data
            hungry = pool.get_hungry_headings()
            if not hungry:
                if progress_cb:
                    progress_cb("All report sections satisfied. Stopping scraping.")
                break
                
            entry = pool.pop_next()
            if entry is None:
                # Queue empty, attempt adaptive re-discovery for remaining hungry headings
                if progress_cb:
                    progress_cb(f"Queue empty. Triggering adaptive re-discovery for hungry sections: {hungry}")
                new_sources = adaptive_rediscovery(pool, hungry)
                if new_sources == 0:
                    break # Exhausted all resources
                continue
                
            fut = executor.submit(_scrape_single_url, entry, pool, progress_cb)
            futures[fut] = entry
            
        concurrent.futures.wait(futures.keys())


def _scrape_single_url(entry: dict, pool: SourcePool, progress_cb) -> bool:
    url = entry["url"]
    if progress_cb:
        progress_cb(f"Scraping: {url}")
        
    try:
        from engine.scraper import fetch_page
        result = fetch_page(url)
        content = result.get("markdown", "")
        images = result.get("images", [])[:3] # Limit to 3 images per page
        
        if content and len(content) > 100:
            pool.submit_scraped_content(url, content, images, entry)
            # Perform structured parameter extraction on the content
            extraction = _extract_facts_from_content(content, entry, pool.blueprint)
            pool.submit_extraction(url, extraction)
            return True
    except Exception as e:
        print(f"Failed to scrape {url}: {e}")
        
    # Submit empty content on failure to mark URL as completed
    pool.submit_scraped_content(url, "", [], entry)
    return False


def _extract_facts_from_content(content: str, entry: dict, blueprint: dict) -> dict:
    """Uses a cheap LLM call to extract specific parameters and entities mentioned on this page."""
    prompt = f"""Extract specific facts, numbers, rates, and entities related to the blueprint requirements from this scraped markdown content.
    
    URL: {entry['url']}
    Title: {entry.get('title', '')}
    Markdown Content (Truncated):
    {content[:6000]}
    
    Return as JSON: {{"extracted_facts": ["fact 1", "fact 2"], "entity_metrics": {{"entity": {{"metric": "value"}}}}}}
    Return ONLY valid JSON."""
    try:
        response = extractor._call_gemini(
            contents=prompt,
            config=extractor.types.GenerateContentConfig(temperature=0.1),
            tier="cheap",
            judgment=False
        )
        return extractor._parse_json_response(response.text) or {}
    except Exception:
        return {}


def adaptive_rediscovery(pool: SourcePool, hungry_heading_ids: list[str]) -> int:
    """
    Triggered when the queue is exhausted but sections are still hungry.
    Generates highly specific search queries for the hungry sections and adds discovered URLs to the pool.
    """
    new_urls_count = 0
    for hid in hungry_heading_ids:
        sec = next((s for s in pool.blueprint["sections"] if s["id"] == hid), None)
        if not sec:
            continue
            
        # Compile a targeted search query based on section instructions
        query_prompt = f"""Generate 3 highly specific search engine queries targeting exact information for:
        Section: "{sec['heading']}"
        Instructions: "{sec.get('instructions', '')}"
        
        Return JSON list of strings: ["query 1", "query 2", "query 3"]"""
        
        try:
            response = extractor._call_gemini(
                contents=query_prompt,
                config=extractor.types.GenerateContentConfig(temperature=0.2),
                tier="cheap",
                judgment=False
            )
            queries = extractor._parse_json_response(response.text)
            if not queries:
                continue
                
            from engine.scraper import ddg_search
            for q in queries[:2]:
                results = ddg_search(q, f"rediscover_{hid}")
                for r in results:
                    pool.add_source(
                        url=r["url"],
                        title=r.get("title", ""),
                        snippet=r.get("snippet", ""),
                        score=60.0,
                        source_type=r.get("source_type", "web"),
                        relevant_heading_ids=[hid],
                        vector_id=f"rediscover_{hid}"
                    )
                    new_urls_count += 1
        except Exception as e:
            print(f"Adaptive rediscovery failed for {hid}: {e}")
            
    return new_urls_count
```

